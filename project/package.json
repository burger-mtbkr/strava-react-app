{
  "name": "strava-react-app",
  "repository": {
    "url": "https://github.com/loanburger/strava-react-app",
    "directory": "https://github.com/loanburger/strava-react-app/project",
    "type": "public"
  },
  "version": "0.2.0",
  "private": false,
  "license": "MIT",
  "author": {
    "name": "Lóan Burger",
    "url": "https://github.com/loanburger"
  },
  "dependencies": {
    "@emotion/react": "^11.10.5",
    "@emotion/styled": "^11.10.5",
    "@mapbox/polyline": "^1.1.1",
    "@mui/icons-material": "^5.10.14",
    "@mui/material": "^5.10.14",
    "@mui/styled-engine-sc": "^5.10.14",
    "@mui/system": "^5.10.14",
    "@mui/utils": "^5.10.14",
    "@reduxjs/toolkit": "^2.9.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.0",
    "@types/mapbox__polyline": "^1.0.2",
    "@types/node": "^24.0.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "axios": "^1.16.1",
    "axios-mock-adapter": "^1.21.2",
    "env-cmd": "^10.1.0",
    "history": "^5.3.0",
    "jest": "^30.2.0",
    "leaflet": "^1.9.2",
    "moment": "^2.29.4",
    "npm-run-all": "^4.1.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.1.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.30.0",
    "redux-logger": "^3.0.6",
    "redux-mock-store": "^1.5.4",
    "redux-persist": "^6.0.0",
    "redux-saga": "^1.2.1",
    "typescript": "5.4.5",
    "victory": "^36.6.8"
  },
  "scripts": {
    "start:local": "env-cmd -f ./environments/.env.local vite",
    "start:dev": "env-cmd -f ./environments/.env.development vite",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint --fix \"src/**/*.{ts,tsx}\"",
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "coverage:critical-flows": "node ./scripts/check-critical-flows.cjs",
    "test:premerge": "npm-run-all lint:fix test",
    "validate": "npm-run-all lint test:coverage coverage:critical-flows"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.(ts|tsx|js|jsx)$": "babel-jest"
    },
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/src/$1",
      "^react-leaflet$": "<rootDir>/src/test/mocks/reactLeaflet.mock.tsx",
      "\\.(css|less|scss|sass)$": "identity-obj-proxy"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/src/setupTests.ts"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/e2e/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(@react-leaflet|react-leaflet)/)"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!src/**/*.d.ts",
      "!src/index.tsx"
    ],
    "coveragePathIgnorePatterns": [
      "./src/*/*.types.{ts,tsx}",
      "./src/index.tsx"
    ],
    "coverageReporters": [
      "json",
      "lcov",
      "text-summary",
      "clover"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 100,
        "branches": 100,
        "functions": 100,
        "lines": 100
      }
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.18.6",
    "@playwright/test": "^1.53.1",
    "@types/redux-logger": "^3.0.9",
    "@types/redux-mock-store": "^1.0.3",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitejs/plugin-react": "^5.0.2",
    "babel-jest": "^30.3.0",
    "babel-preset-vite": "^1.1.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "identity-obj-proxy": "^3.0.0",
    "jest-environment-jsdom": "^30.2.0",
    "prettier": "^3.8.3",
    "vite": "^7.1.0"
  }
}
